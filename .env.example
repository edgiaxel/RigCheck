# RigCheck Backend Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Remote Access Security (Set a strong secret to protect public tunnel access)
ACCESS_SECRET=generate_strong_secret_at_least_16_chars_here
SESSION_TTL_HOURS=24
MAX_FAILED_AUTH_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=30

# Ollama Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=60.0

# SerpAPI Configuration (Technical specification search)
SERPAPI_API_KEY=your_serpapi_key_here
SERPAPI_ENABLED=true
SERPAPI_TIMEOUT_SECONDS=10.0

# Storage & upload limits
PROFILE_STORAGE_PATH=data/user_profile.json
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
